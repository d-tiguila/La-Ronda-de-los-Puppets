# Railway injects PORT automatically. Keep this value for local tests.
PORT=3000

# Required in production. Use the same secret in the TouchDesigner WebSocket URL.
TD_TOKEN=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to open controller sockets.
# Add the Railway public domain after deployment.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

